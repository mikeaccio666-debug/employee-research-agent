# Copy to .env.local for development; in production set these in the Vercel project settings.
# Without them the app runs on the canvas's example data and sign-in shows "not set up yet".

# Supabase → Project Settings → API. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The studio agent (step 2). Server-only: never prefix these with NEXT_PUBLIC_.
# Without OPENAI_API_KEY the studio still loads, and says the agent isn't connected.
OPENAI_API_KEY=sk-...
# Optional: the model (default gpt-5), reasoning effort for reasoning models, an OpenAI-compatible
# gateway, and the per-person daily message cap (default 200).
# OPENAI_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=medium
# OPENAI_BASE_URL=
# AGENT_DAILY_MESSAGES=200
