# Copy to .env.local for development; in production set these in the Vercel project settings.
# Without them the app runs on the canvas's example data and sign-in shows "not set up yet".

# Supabase → Project Settings → API. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The studio agent (step 2). Server-only: never prefix these with NEXT_PUBLIC_.
# Two providers: OpenAI and Anthropic. Set the key for one (or both, and pick with AGENT_PROVIDER).
# Without any key the studio still loads, and says the agent isn't connected.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: which provider to use when both keys are set (default openai), each provider's model
# (defaults gpt-6.1-sol and claude-opus-5-5), how hard the model thinks (low, medium, high; default
# medium), another endpoint for the same API, and the per-person daily message cap (default 200).
# AGENT_PROVIDER=openai
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# AGENT_DAILY_MESSAGES=200
# Optional: a GitHub token (no scopes needed) so reading people's GitHub profiles isn't rate-limited.
# GITHUB_TOKEN=
# Who can pick the model in the studio among the providers with a key: everyone (default), admins
# (only AGENT_ADMIN_EMAILS, comma-separated) or off. A per-model daily cap keeps a pricier model in check.
# AGENT_MODEL_SWITCHER=everyone
# AGENT_ADMIN_EMAILS=you@example.com
# AGENT_DAILY_MESSAGES_OPENAI=
# AGENT_DAILY_MESSAGES_ANTHROPIC=
# The models people can pick for each provider, comma-separated, the default first (defaults: the
# provider's model above, plus gpt-6-luna for OpenAI and claude-sonnet-5-5, claude-haiku-5-5 for
# Claude). People also pick how hard it thinks (Quick, Balanced, Deep = low, medium, high).
# OPENAI_MODELS=gpt-6.1-sol,gpt-6-luna
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Long conversations: past about this many tokens, all but the last few messages are condensed into
# notes by a cheaper model of the same provider (defaults gpt-6-luna, claude-haiku-5-5).
# AGENT_CONTEXT_TOKENS=24000
# OPENAI_SUMMARY_MODEL=gpt-6-luna
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
