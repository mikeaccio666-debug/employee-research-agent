# Copy to .env.local for development; in production set these in the Vercel project settings.
# Without them the app runs on the canvas's example data and sign-in shows "not set up yet".

# Supabase → Project Settings → API. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The studio agent (step 2). Server-only: never prefix these with NEXT_PUBLIC_.
# Two providers: OpenAI and Anthropic. Set the key for one (or both, and pick with AGENT_PROVIDER).
# Without any key the studio still loads, and says the agent isn't connected.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: which provider to use when both keys are set (default openai), each provider's model
# (defaults gpt-6.1-sol and claude-opus-5-5), how hard the model thinks (low, medium, high; default
# medium), another endpoint for the same API, and the per-person daily message cap (default 200).
# AGENT_PROVIDER=openai
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# AGENT_DAILY_MESSAGES=200
# Emails (comma-separated) that see a model switcher in the studio, to compare providers while testing.
# AGENT_ADMIN_EMAILS=you@example.com
