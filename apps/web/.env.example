# Copy to .env.local for development; in production set these in the Vercel project settings.
# Without them the app runs on the canvas's example data and sign-in shows "not set up yet".

# Supabase → Project Settings → API. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
